<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 任意路径读写：关掉 App Sandbox（理由同 DebugProfile.entitlements）。
	     沙箱开着时只能拿到"用户在文件选择器里选中的那个"，拿不到任意路径。 -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- 出站网络：只连用户指定的 MC 服务器（项目网络红线）。
	     漏了这条会静默失败：沙箱直接拒绝 Socket.connect，
	     表现是"点了加入服务器但服务器日志里毫无连接痕迹"。 -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>

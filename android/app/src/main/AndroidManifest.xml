<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ── 网络 ────────────────────────────────────────────────────────────
         联机只连用户指定的 MC 服务器（项目网络红线）。Flutter 的
         debug/profile 变体清单里已有 INTERNET，main 里补一份，让 release
         也能联网。ACCESS_NETWORK_STATE 用于读网络可达性做连接前置检查。 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- ── 前台服务：承载保活 ──────────────────────────────────────────────
         被托管服务端与宿主同进程（进程内 JVM），退到后台时须靠前台服务维持宿主进程存活
         （spec「长期运行以前台服务保活」）。类型照参考实现 FCL 的 GameService 取
         specialUse（不用 dataSync：Android 15+ 对 dataSync 型前台服务有 6 小时强制超时，
         长期挂服会被系统掐停；specialUse 无此限制）。旧系统不校验类型，声明不影响。
         通知权限（API 33+）属可选：未授予时前台服务仍可运行，只是不显示通知。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- ── 存储：任意路径读写 ──────────────────────────────────────────────
         READ/WRITE_EXTERNAL_STORAGE 自 Android 10（API 29）起废弃，Android 13
         （API 33）起彻底失效，故用 maxSdkVersion=32 限定只在旧系统生效。
         Android 11（API 30）起要读写**任意路径**（不是文件选择器挑中的那个），
         只能靠 MANAGE_EXTERNAL_STORAGE（"所有文件的访问权限"）：
           · 它是高危权限，运行时权限弹窗不会自动授予，
             必须由用户到设置页手动打开 → 用
             Permission.manageExternalStorage.request() 跳转系统设置页；
           · 上架 Google Play 需额外提交使用声明，本应用为本地开发用途。
         插件自身清单是空的（permission_handler_android 未声明任何权限），
         所以这些必须写在本应用的清单里。 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:label="flutter_mc"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
            <meta-data android:name="io.flutter.embedding.android.EnableFlutterGPU" android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 承载保活服务：起服即起、停服即停（见 LocalServerKeepAliveService）。
             不导出（只由本应用启停）；不开新进程——被托管 JVM 就在本进程内，另开进程
             会切断"宿主进程终止 ⇒ 服务端一并终止"的口径（spec「进程内承载的生命周期释放口径」）。
             （参考实现 FCL 的 ProcessService 走 `:jvm` 独立进程——那是因为它的游戏进程
             与启动器分离；我们的被托管 JVM 与宿主同进程，口径相反，属有意偏离。）
             specialUse 的 subtype 注明用途（Android 14+ 审查用），照 FCL GameService。 -->
        <service
            android:name=".LocalServerKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keep the hosted Minecraft dedicated server (in-process JVM) alive while running" />
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
